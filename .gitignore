# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.pdb
# Allow vendored Windows pgvector for portable installer (must match bundled PG major).
!build/installer/bundled/**/vector.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/
/cmd/kratos-admin

# SQLite WAL mode sidecar files (auto-generated; never commit)
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# Develop tools
.vscode/
.cache/
.tools/

.idea/
*.swp

# ----- 生成物（CI 构建需要 protoc/ent/wire 生成物，已提交到仓库确保 go build 可用）-----

# protoc → Go（*.proto 和 *.pb.go 都提交，CI 构建需要）
# api/**/*.pb.go
# internal/**/*.pb.go

# gnostic / kratos → 仓库根 OpenAPI（不需要提交）
/openapi.yaml
/openapi.json

# Ent（schema/ 和 generate.go 以及生成代码都提交）
# /internal/data/ent/*
# !/internal/data/ent/schema/
# !/internal/data/ent/schema/**
# !/internal/data/ent/generate.go

# wire（已提交，CI 构建需要）
# **/wire_gen.go

# protoc → 前端 TS 客户端（CI 构建需要，已提交到仓库）
# web/src/services/kratos/

# 前端依赖与构建
web/node_modules/
web/dist/
web/dist2/
web/build/
web/.quasar/
web/**/*.tsbuildinfo

# 环境与本地配置
.env
.env.*
!.env.example

# 测试与覆盖率
coverage.out
coverage.html
*.coverprofile
profile.cov

# 本地草稿 / 演示输出（勿提交）
/tmp_*.go
/manager_notes_*.md
/output/
/node_modules
node_modules/
/.gocache*
/.cache-go-build/
test/*gocache*
test/.gocache*
/.aranea-self-improve/
/workspace
/data
# Docker 运行时产物（日志/数据/迁移 dump），不入库；docker/config 为生成式 overlay 需跟踪
/docker/volumes/
# 运行日志已迁至 bin/logs（configs/*.yaml output_dir=./bin/logs）；保留本条目防止旧配置复发
/logs/
/.dogfood-output/
/cmd/admin/logs/
/AraneaAgents-deploy
/.auto-fix
/.codegraph
/.dbg
/.husky
/.superpowers
/.tools
/.trae


# 冒烟/调试临时产物（勿提交）
**/cookies.txt
**/.cookies.txt
docker/.test-*
docker/.*.json
/cmd/admin/data/
/cmd/reset_admin_pw/*.json
web/eslint-out.txt

# 安装包构建产物（release.yml 运行时生成，勿提交）
# build/ 目录同时存放需要入库的构建脚本（*.ps1）与 NSIS 脚本（installer/），
# 仅忽略运行时产物：deps（下载的 PG/Redis）、staging*（组装中间态）、release（安装包输出）
/build/deps/
/build/staging*/
/build/release/
/seed_*.txt

# trpc-agent-go 非核心目录（框架自带示例/文档/测试，项目不 import，且含超长路径文件导致 Windows checkout 失败）
/pkg/trpc-agent-go/examples/
/pkg/trpc-agent-go/benchmark/
/pkg/trpc-agent-go/docs/
/pkg/trpc-agent-go/test/
/promo-videos
/.study

# ----- 仓库整理（2026-08-07）：中间产物、媒体与大文件不入库 -----
# 测试中间产物（project_rules: test/ 为本地排查目录；评测 smoke 脚本例外保留）
/test/*
!/test/agent-memory-challenge/
/test/agent-memory-challenge/*
!/test/agent-memory-challenge/smoke.sh
!/test/cua-win-smoke/
/test/cua-win-smoke/*
!/test/cua-win-smoke/smoke.ps1
# .NET sidecar（internal/computeruse）构建产物
# bin/ 已由上方全局规则覆盖；此处再钉死 obj / 发布目录，避免漏网
/internal/computeruse/**/obj/
/internal/computeruse/**/bin/
/internal/computeruse/**/artifacts/
/internal/computeruse/**/.vs/
/internal/computeruse/**/TestResults/
# Python 缓存
__pycache__/
*.pyc
# Playwright MCP 浏览器产物
.playwright-mcp/
# 历史遗留目录（AGENTS.md: 逐步归档后删除）与已废弃 scripts/（脚本已迁入 build/）
/_temp/
/_tmp_dbcheck/
/tmp/
/scripts/
/.tmp/
# 比赛提交包归档 zip（重新打包即可生成，不入库）
competition/**/*.zip
# 宣传视频媒体产物（TTS 音频/录屏/成片；js/ts/md/json 源文件保留）
docs/promo-videos/**/*.webm
docs/promo-videos/**/*.mp4
docs/promo-videos/**/*.mp3
# blender 渲染产物（不入库）
/blender/
/competition/