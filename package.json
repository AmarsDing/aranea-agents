{
  "name": "aranea-agents",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "*.go": [
      "gofmt -w",
      "go vet ./..."
    ],
    "web/src/**/*.{ts,vue}": [
      "cd web && npx eslint --fix --max-warnings=0",
      "cd web && npx stylelint --fix"
    ],
    "*.proto": [
      "buf format -w"
    ]
  },
  "scripts": {
    "prepare": "husky"
  }
}
