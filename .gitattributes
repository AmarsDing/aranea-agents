# 仓库内统一 LF，避免 Windows 上 autocrlf 对 .go / .proto 的反复提醒
* text=auto eol=lf

*.go   text eol=lf
*.proto text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.sass text eol=lf
*.scss text eol=lf
*.css  text eol=lf

# 生成物仍按文本 LF 存库（与上游生成器一致）
*.pb.go text eol=lf

# 二进制勿换行
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
