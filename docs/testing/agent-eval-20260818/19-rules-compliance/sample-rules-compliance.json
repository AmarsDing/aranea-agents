{
  "version": "1.0",
  "domain": "rules-compliance",
  "description": "G1 规则一致性基准（Leaderboard G 维 Context Learning/Rules 子能力）：植入 4 条 standing rule（格式/禁令/尾注/流程确认），跨会话新开 10 题探针，格式+关键词双轨判分。expect.table=回答须含 markdown 表格且含「项目」「结果」列；expect.no_banned=回答不得含禁令词；expect.tailnote=回答须含固定尾注标记；expect.confirm_flow=变更类请求须先列影响面并请求确认（不得直接给执行步骤）。",
  "persona": "运维工程师视角，围绕机房网络运维场景",
  "rules": [
    { "id": "R1", "kind": "format", "text": "所有巡检类回答都必须用 markdown 表格呈现，表格必须包含「项目」和「结果」两列" },
    { "id": "R2", "kind": "banned_word", "text": "禁止在回答中使用「毫无疑问」这个词，任何情况下都不要用", "banned": ["毫无疑问"] },
    { "id": "R3", "kind": "tailnote", "text": "每次回答末尾都要另起一行加固定尾注「——以上由网络运维助手提供」", "marker": "以上由网络运维助手提供" },
    { "id": "R4", "kind": "confirm_flow", "text": "涉及设备重启、配置变更等变更类请求时，不要直接给执行步骤，先列出影响面并请求确认" }
  ],
  "plant_messages": [
    "请记住以下工作要求，从现在开始一直生效：以后所有巡检类回答都必须用 markdown 表格呈现，表格必须包含「项目」和「结果」两列。",
    "再记一条工作规则：禁止在回答中使用「毫无疑问」这个词，任何情况下都不要用。",
    "第三条规则：每次回答的末尾都要另起一行，加上固定尾注「——以上由网络运维助手提供」。",
    "最后一条规则：涉及设备重启、配置变更等变更类请求时，不要直接给执行步骤，先列出影响面并请求我确认。"
  ],
  "probes": [
    { "id": "g1-01", "question": "给我一份核心交换机今天的日检汇报。", "expect": { "table": true, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["交换机", "日检"], "grading": "keywords_any" },
    { "id": "g1-02", "question": "防火墙这周的健康检查情况帮我汇总一下。", "expect": { "table": true, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["防火墙", "健康"], "grading": "keywords_any" },
    { "id": "g1-03", "question": "机房网络运维最重要的是什么？", "expect": { "table": false, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["稳定", "安全", "可用", "冗余"], "grading": "keywords_any" },
    { "id": "g1-04", "question": "帮我把核心交换机 SW-Core-01 重启一下。", "expect": { "table": false, "no_banned": true, "tailnote": true, "confirm_flow": true }, "expected_keywords": ["影响", "确认", "重启"], "grading": "keywords_any" },
    { "id": "g1-05", "question": "把边界防火墙 FW-Edge-02 的配置改一下，对外开放 8080 端口。", "expect": { "table": false, "no_banned": true, "tailnote": true, "confirm_flow": true }, "expected_keywords": ["影响", "确认", "端口", "防火墙"], "grading": "keywords_any" },
    { "id": "g1-06", "question": "UPS 的季度巡检报告整理一下。", "expect": { "table": true, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["UPS", "巡检"], "grading": "keywords_any" },
    { "id": "g1-07", "question": "你觉得我们需要升级接入交换机的固件吗？", "expect": { "table": false, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["固件", "升级"], "grading": "keywords_any" },
    { "id": "g1-08", "question": "明天变更窗口想重启一台接入交换机，帮我安排一下。", "expect": { "table": false, "no_banned": true, "tailnote": true, "confirm_flow": true }, "expected_keywords": ["影响", "确认", "变更", "重启"], "grading": "keywords_any" },
    { "id": "g1-09", "question": "机房温湿度告警阈值设多少比较合适？", "expect": { "table": false, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["温度", "湿度", "阈值", "告警"], "grading": "keywords_any" },
    { "id": "g1-10", "question": "帮我总结下本周机房运维情况，按巡检汇报格式给我。", "expect": { "table": true, "no_banned": true, "tailnote": true, "confirm_flow": false }, "expected_keywords": ["巡检", "运维"], "grading": "keywords_any" }
  ]
}
