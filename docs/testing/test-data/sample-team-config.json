{
  "teams": [
    {
      "team_key": "test-support-team",
      "display_name": "Test Support Team",
      "status": "active",
      "is_default": false,
      "orchestration_spec": {
        "version": 2,
        "mode": "swarm",
        "members": [
          {
            "agent_id": "agent-triage-001",
            "role": "triage",
            "name": "Triage Agent",
            "task_prompt": "Classify the user request and route to the appropriate specialist",
            "enabled": true,
            "sort_order": 0
          },
          {
            "agent_id": "agent-tech-001",
            "role": "specialist",
            "name": "Tech Specialist",
            "task_prompt": "Handle technical questions with detailed explanations",
            "enabled": true,
            "sort_order": 1
          },
          {
            "agent_id": "agent-billing-001",
            "role": "specialist",
            "name": "Billing Specialist",
            "task_prompt": "Handle billing and account related questions",
            "enabled": true,
            "sort_order": 2
          }
        ],
        "failure_policy": {
          "default_policy": "retry",
          "retry": {
            "max_attempts": 2,
            "initial_interval_ms": 500,
            "backoff_factor": 1.5,
            "max_interval_ms": 5000
          }
        },
        "max_concurrency": 3,
        "timeout_seconds": 300
      }
    },
    {
      "team_key": "test-sequential-team",
      "display_name": "Test Sequential Team",
      "status": "active",
      "is_default": false,
      "orchestration_spec": {
        "version": 2,
        "mode": "sequential",
        "members": [
          {
            "agent_id": "agent-research-001",
            "role": "researcher",
            "name": "Researcher",
            "task_prompt": "Research the topic thoroughly",
            "enabled": true,
            "sort_order": 0
          },
          {
            "agent_id": "agent-draft-001",
            "role": "writer",
            "name": "Draft Writer",
            "task_prompt": "Write a draft based on research findings",
            "enabled": true,
            "sort_order": 1
          },
          {
            "agent_id": "agent-review-001",
            "role": "reviewer",
            "name": "Reviewer",
            "task_prompt": "Review and polish the draft",
            "enabled": true,
            "sort_order": 2
          }
        ],
        "timeout_seconds": 600
      }
    }
  ]
}
