        <!-- Async P1 phase -->
        <mxCell id="init-async-label" value="&lt;font style=&quot;font-size:12px;&quot; color=&quot;#EC4899&quot;&gt;&lt;b&gt;ASYNC P1&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
