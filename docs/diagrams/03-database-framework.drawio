        <!-- Compile-time check badge -->
        <mxCell id="wire-checks" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#64748B&quot;&gt;&lt;b&gt;26+ Compile-time Checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:monospace;&quot;&gt;var _ biz.AgentRepo = (*agentRepo)(nil)&lt;br&gt;var _ biz.SessionRepo = (*sessionRepo)(nil)&lt;br&gt;var _ biz.ChannelRepo = (*channelRepo)(nil)&lt;br&gt;var _ biz.KnowledgeRepo = (*knowledgeRepo)(nil)&lt;br&gt;var _ biz.MemoryRepo = (*memoryRepo)(nil)&lt;br&gt;var _ biz.ToolRepo = (*toolRepo)(nil)&lt;br&gt;var _ biz.HookRepo = (*hookRepo)(nil)&lt;br&gt;... 19+ more&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
