          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Migration versions -->
        <mxCell id="ddl-versions" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#9D174D&quot;&gt;&lt;b&gt;37 Migrations&lt;/b&gt; (20260601 ~ 20260707)&lt;br&gt;Each migration: idempotent DDL&lt;br&gt;CREATE TABLE IF NOT EXISTS&lt;br&gt;CREATE INDEX IF NOT EXISTS&lt;br&gt;ALTER TABLE ADD COLUMN IF NOT EXISTS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#EC4899;strokeWidth=1;shadow=0;arcSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="780" width="250" height="80" as="geometry" />
