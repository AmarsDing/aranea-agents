        <mxCell id="arrow-async-2-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B82F6;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="init-pg-schema" target="init-data-mig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-async-3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="init-data-mig" target="init-seed-p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Readiness gate note -->
        <mxCell id="init-readiness" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#64748B&quot;&gt;&lt;b&gt;ReadinessGate&lt;/b&gt; blocks traffic until async P1 completes&lt;br&gt;HTTP /healthz returns 503 until ready&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;shadow=0;arcSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1810" y="810" width="330" height="45" as="geometry" />
        </mxCell>

        <!-- ========== THREE SQL PATTERNS ========== -->
        <mxCell id="patterns-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="2120" height="280" as="geometry" />
        </mxCell>
        <mxCell id="patterns-title" value="&lt;b&gt;&lt;font style=&quot;font-size:16px;&quot; color=&quot;#64748B&quot;&gt;Three SQL Usage Patterns&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="920" y="988" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- Pattern 1: Ent CRUD -->
        <mxCell id="pat1-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1025" width="660" height="215" as="geometry" />
        </mxCell>
        <mxCell id="pat1-title" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;&quot; color=&quot;#8B5CF6&quot;&gt;Pattern 1: Ent CRUD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#8B5CF6&quot;&gt;agent_repo.go &amp;middot; session_repo.go &amp;middot; ...&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="1033" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pat1-code" value="&lt;font style=&quot;font-size:10px;font-family:monospace;&quot; color=&quot;#5B21B6&quot;&gt;// Type-safe Ent CRUD&lt;br&gt;func (r *agentRepo) Create(ctx, req) {&lt;br&gt;  client := r.data.rw.Write(ctx)&lt;br&gt;  return client.Agent.Create()&lt;br&gt;    .SetName(req.Name)&lt;br&gt;    .SetModel(req.Model)&lt;br&gt;    .Save(ctx)&lt;br&gt;}&lt;br&gt;&lt;br&gt;func (r *agentRepo) Get(ctx, id) {&lt;br&gt;  client := r.data.rw.Read(ctx)&lt;br&gt;  return client.Agent.Get(ctx, id)&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1078" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat1-flow" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#5B21B6&quot;&gt;&lt;b&gt;Flow&lt;/b&gt;:&lt;br&gt;Repo → ReadWriteClient&lt;br&gt;→ Ent Client&lt;br&gt;→ SQLite (via entsql)&lt;br&gt;&lt;br&gt;&lt;b&gt;Traits&lt;/b&gt;:&lt;br&gt;✓ Type-safe&lt;br&gt;✓ Auto-generated&lt;br&gt;✓ Read/Write split&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1;shadow=0;arcSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="1078" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- Pattern 2: Raw SQL -->
        <mxCell id="pat2-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="1025" width="660" height="215" as="geometry" />
        </mxCell>
        <mxCell id="pat2-title" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;&quot; color=&quot;#F59E0B&quot;&gt;Pattern 2: Raw SQL (SessionMemory)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#F59E0B&quot;&gt;store_l0_snapshot.go &amp;middot; store_l1_short_term.go &amp;middot; ...&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="860" y="1033" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pat2-code" value="&lt;font style=&quot;font-size:10px;font-family:monospace;&quot; color=&quot;#92400E&quot;&gt;// Complex upsert + vector&lt;br&gt;func (s *L0Store) Upsert(ctx, snap) {&lt;br&gt;  db := s.data.rwDB.WriteDB(ctx)&lt;br&gt;  _, err := db.ExecContext(ctx,&lt;br&gt;    `INSERT INTO l0_snapshot&lt;br&gt;     (session_id, data, updated_at)&lt;br&gt;     VALUES ($1, $2, $3)&lt;br&gt;     ON CONFLICT(session_id)&lt;br&gt;     DO UPDATE SET data=$2`,&lt;br&gt;    snap.SessionID, snap.Data, now)&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="1078" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat2-flow" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#92400E&quot;&gt;&lt;b&gt;Flow&lt;/b&gt;:&lt;br&gt;Store → ReadWriteDB&lt;br&gt;→ sql.DB&lt;br&gt;→ SQLite (raw)&lt;br&gt;&lt;br&gt;&lt;b&gt;Traits&lt;/b&gt;:&lt;br&gt;✓ Complex UPSERT&lt;br&gt;✓ Vector operations&lt;br&gt;✓ L0-L4 memory layers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1;shadow=0;arcSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1078" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- Pattern 3: PostgreSQL -->
        <mxCell id="pat3-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1025" width="720" height="215" as="geometry" />
        </mxCell>
        <mxCell id="pat3-title" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;&quot; color=&quot;#3B82F6&quot;&gt;Pattern 3: Knowledge PostgreSQL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#3B82F6&quot;&gt;knowledge.go &amp;middot; vector_search.go&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1033" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pat3-code" value="&lt;font style=&quot;font-size:10px;font-family:monospace;&quot; color=&quot;#1E40AF&quot;&gt;// Pure pgvector similarity&lt;br&gt;func (r *knowledgeRepo) Search(ctx, q) {&lt;br&gt;  db := r.data.pg  // direct pg&lt;br&gt;  rows, err := db.QueryContext(ctx,&lt;br&gt;    `SELECT id, content,&lt;br&gt;     1 - (embedding &lt;=&gt; $1::vector)&lt;br&gt;     AS similarity&lt;br&gt;     FROM knowledge_chunks&lt;br&gt;     ORDER BY embedding &lt;=&gt; $1::vector&lt;br&gt;     LIMIT $2`, q.Embedding, q.Limit)&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1078" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat3-flow" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#1E40AF&quot;&gt;&lt;b&gt;Flow&lt;/b&gt;:&lt;br&gt;Repo → data.pg&lt;br&gt;→ PostgreSQL&lt;br&gt;→ pgvector ops&lt;br&gt;&lt;br&gt;&lt;b&gt;Traits&lt;/b&gt;:&lt;br&gt;✓ Cosine similarity&lt;br&gt;✓ ivfflat index&lt;br&gt;✓ Independent tx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;shadow=0;arcSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1760" y="1078" width="200" height="150" as="geometry" />
        </mxCell>

