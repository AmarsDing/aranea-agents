        <mxCell id="init-pg-schema" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;ensurePostgresSchemas&lt;/b&gt;&lt;br&gt;pgvector tables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="820" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init-data-mig" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;runPendingDataMigrations&lt;/b&gt;&lt;br&gt;Data transforms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1480" y="820" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init-seed-p1" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;seedP1Data&lt;/b&gt;&lt;br&gt;Lazy seeders&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="820" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Async arrows -->
        <mxCell id="arrow-async-1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EC4899;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="init-ddl" target="init-pg-schema">
