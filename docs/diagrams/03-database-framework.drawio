        <mxCell id="init-title" value="&lt;b&gt;&lt;font style=&quot;font-size:16px;&quot; color=&quot;#64748B&quot;&gt;Initialization Flow (NewData)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
