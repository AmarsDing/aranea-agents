        <mxCell id="init-ddl" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;ensureSchemaDDL&lt;/b&gt;&lt;br&gt;37 migrations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#EC4899;strokeWidth=1.5;shadow=1;arcSize=12;" vertex="1" parent="1">
