{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuantFactorOutput",
  "type": "object",
  "required": ["factor_name", "factor_type", "ic_analysis", "factor_return", "turnover_analysis", "long_short_performance", "disclaimer"],
  "properties": {
    "factor_name": {
      "type": "string",
      "description": "因子名称"
    },
    "factor_type": {
      "type": "string",
      "enum": ["price_volume", "fundamental", "alternative", "technical"],
      "description": "因子类型"
    },
    "ic_analysis": {
      "type": "object",
      "required": ["ic_mean", "ic_std", "icir", "ic_win_rate"],
      "properties": {
        "ic_mean": {
          "type": "number",
          "description": "IC均值"
        },
        "ic_std": {
          "type": "number",
          "description": "IC标准差"
        },
        "icir": {
          "type": "number",
          "description": "信息系数信息比（IC/IC标准差）"
        },
        "ic_win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "IC胜率"
        },
        "ic_decay": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lag": { "type": "integer" },
              "ic": { "type": "number" }
            }
          },
          "description": "IC衰减分析"
        }
      }
    },
    "factor_return": {
      "type": "object",
      "required": ["long_short_return", "long_excess_return"],
      "properties": {
        "long_short_return": {
          "type": "number",
          "description": "多空收益（年化）"
        },
        "long_excess_return": {
          "type": "number",
          "description": "多头超额收益（年化）"
        },
        "sharpe_ratio": {
          "type": "number",
          "description": "夏普比率"
        }
      }
    },
    "turnover_analysis": {
      "type": "object",
      "required": ["daily_turnover", "transaction_cost_impact"],
      "properties": {
        "daily_turnover": {
          "type": "number",
          "description": "日换手率"
        },
        "transaction_cost_impact": {
          "type": "number",
          "description": "交易成本对收益的侵蚀"
        }
      }
    },
    "long_short_performance": {
      "type": "object",
      "required": ["quantile_returns"],
      "properties": {
        "quantile_returns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quantile": { "type": "integer" },
              "return": { "type": "number" }
            }
          },
          "description": "分位数收益"
        },
        "monotonicity": {
          "type": "number",
          "description": "单调性指标"
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "description": "免责声明"
    }
  }
}
