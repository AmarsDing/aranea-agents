{
  "name": "arenea-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:layer": "node scripts/check-frontend-layer.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "stylelint": "stylelint \"src/**/*.{vue,css,sass,scss}\" --config .stylelintrc.json",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css,sass,scss}\" --config .stylelintrc.json --fix",
    "lint": "eslint \"src/**/*.{ts,vue}\" && node scripts/check-i18n.mjs",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss}\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "clean-config": "node clean-backend.cjs",
    "inject-backend": "node set-backend.cjs",
    "serve": "npm run clean-config && npm run inject-backend && quasar dev",
    "electron:build": "node scripts/build-electron.mjs --platform=win32 --arch=x64"
  },
  "dependencies": {
    "@types/dagre": "^0.7.54",
    "@types/markdown-it": "^14.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.18.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.2",
    "quasar": "^2.23.5",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.2.9",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.1",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^0.1.6",
    "@playwright/test": "^1.60.0",
    "@quasar/app-vite": "^2.6.0",
    "@quasar/extras": "^1.18.0",
    "@quasar/vite-plugin": "^1.11.0",
    "@types/node": "^24.0.12",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.89.2",
    "stylelint": "^17.11.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
