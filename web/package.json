{
  "name": "arenea-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:layer": "node scripts/check-frontend-layer.mjs",
    "stylelint": "stylelint \"src/**/*.{vue,css,sass,scss}\" --config .stylelintrc.json",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css,sass,scss}\" --config .stylelintrc.json --fix",
    "clean-config": "node clean-backend.cjs",
    "inject-backend": "node set-backend.cjs",
    "serve": "npm run clean-config && npm run inject-backend && quasar dev"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.9.0",
    "dompurify": "^3.4.1",
    "echarts": "^6.1.0",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.2",
    "quasar": "^2.19.3",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.2.9",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.6",
    "@quasar/app-vite": "^2.6.0",
    "@quasar/extras": "^1.18.0",
    "@quasar/vite-plugin": "^1.11.0",
    "@types/node": "^24.0.12",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.0",
    "happy-dom": "^17.6.0",
    "sass-embedded": "^1.89.2",
    "stylelint": "^17.11.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
