{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BacktestReportOutput",
  "type": "object",
  "required": ["strategy_name", "backtest_period", "performance_metrics", "risk_metrics", "assumptions", "disclaimer"],
  "properties": {
    "strategy_name": {
      "type": "string",
      "description": "策略名称"
    },
    "backtest_period": {
      "type": "object",
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "回测开始日期"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "回测结束日期"
        },
        "out_of_sample_start": {
          "type": "string",
          "format": "date",
          "description": "样本外测试开始日期"
        }
      }
    },
    "performance_metrics": {
      "type": "object",
      "required": ["annualized_return", "sharpe_ratio", "max_drawdown", "calmar_ratio", "win_rate", "profit_loss_ratio"],
      "properties": {
        "annualized_return": {
          "type": "number",
          "description": "年化收益率"
        },
        "sharpe_ratio": {
          "type": "number",
          "description": "夏普比率"
        },
        "max_drawdown": {
          "type": "number",
          "description": "最大回撤"
        },
        "calmar_ratio": {
          "type": "number",
          "description": "卡尔玛比率"
        },
        "win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "胜率"
        },
        "profit_loss_ratio": {
          "type": "number",
          "description": "盈亏比"
        },
        "avg_holding_days": {
          "type": "number",
          "description": "平均持仓天数"
        },
        "total_trades": {
          "type": "integer",
          "description": "总交易次数"
        }
      }
    },
    "risk_metrics": {
      "type": "object",
      "properties": {
        "annualized_volatility": {
          "type": "number",
          "description": "年化波动率"
        },
        "var_95": {
          "type": "number",
          "description": "95% VaR"
        },
        "cvar_95": {
          "type": "number",
          "description": "95% CVaR"
        },
        "downside_deviation": {
          "type": "number",
          "description": "下行偏差"
        },
        "sortino_ratio": {
          "type": "number",
          "description": "索提诺比率"
        }
      }
    },
    "assumptions": {
      "type": "object",
      "required": ["slippage_model", "transaction_cost"],
      "properties": {
        "slippage_model": {
          "type": "string",
          "description": "滑点模型说明"
        },
        "transaction_cost": {
          "type": "number",
          "description": "交易成本（双边，万分之）"
        },
        "liquidity_constraint": {
          "type": "string",
          "description": "流动性约束说明"
        },
        "survivorship_bias": {
          "type": "boolean",
          "description": "是否处理了存活者偏差"
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "description": "免责声明"
    }
  }
}
