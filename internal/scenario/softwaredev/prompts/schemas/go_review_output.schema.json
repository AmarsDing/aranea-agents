{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoReviewOutput",
  "description": "Go 代码审查输出结构",
  "type": "object",
  "required": ["summary", "issues"],
  "properties": {
    "summary": {
      "type": "object",
      "required": ["file", "total_issues", "critical_count", "major_count", "minor_count", "suggestion_count"],
      "properties": {
        "file": { "type": "string", "description": "审查文件路径" },
        "total_issues": { "type": "integer", "description": "问题总数" },
        "critical_count": { "type": "integer", "description": "Critical 问题数" },
        "major_count": { "type": "integer", "description": "Major 问题数" },
        "minor_count": { "type": "integer", "description": "Minor 问题数" },
        "suggestion_count": { "type": "integer", "description": "Suggestion 问题数" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "file", "line", "category", "description", "suggestion"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "suggestion"] },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "category": { "type": "string", "enum": ["correctness", "compliance", "security", "performance", "maintainability"] },
          "description": { "type": "string" },
          "suggestion": { "type": "string" },
          "code_snippet": { "type": "string", "description": "修复建议代码片段" }
        }
      }
    }
  }
}
