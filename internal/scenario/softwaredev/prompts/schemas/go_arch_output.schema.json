{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoArchOutput",
  "description": "Go 架构设计输出结构",
  "type": "object",
  "required": ["problem_analysis", "solution_overview", "interface_contracts", "data_models", "key_decisions", "risk_assessment", "implementation_path"],
  "properties": {
    "problem_analysis": {
      "type": "object",
      "required": ["business_scenario", "core_constraints"],
      "properties": {
        "business_scenario": { "type": "string", "description": "业务场景描述" },
        "core_constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "核心约束列表"
        }
      }
    },
    "solution_overview": {
      "type": "object",
      "required": ["summary", "architecture_diagram"],
      "properties": {
        "summary": { "type": "string", "description": "一句话方案总结" },
        "architecture_diagram": { "type": "string", "description": "Mermaid 架构图" }
      }
    },
    "interface_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "definition"],
        "properties": {
          "name": { "type": "string", "description": "契约名称" },
          "type": { "type": "string", "enum": ["proto", "go_interface"] },
          "definition": { "type": "string", "description": "契约定义内容" }
        }
      }
    },
    "data_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields", "relationships"],
        "properties": {
          "name": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "type"],
              "properties": {
                "target": { "type": "string" },
                "type": { "type": "string", "enum": ["one_to_one", "one_to_many", "many_to_many"] }
              }
            }
          }
        }
      }
    },
    "key_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "options", "choice", "rationale"],
        "properties": {
          "decision": { "type": "string", "description": "决策点" },
          "options": { "type": "array", "items": { "type": "string" } },
          "choice": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "risk_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "severity", "mitigation"],
        "properties": {
          "risk": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "implementation_path": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "deliverables", "estimated_effort"],
        "properties": {
          "phase": { "type": "string" },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "estimated_effort": { "type": "string" }
        }
      }
    }
  }
}
